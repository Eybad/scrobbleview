# Node
node_modules/
npm-debug.log*

# Sistema
.DS_Store
Thumbs.db

# Editores
.vscode/
.idea/
*.swp

# Descarga de Spotify: historial, identidad, cuenta, playlists, podcasts.
# Fail-closed: se ignora TODO .json y se re-incluye solo lo que el proyecto
# necesita versionar. Enumerar los nombres conocidos de la export deja pasar
# cualquier archivo futuro o unexpected (p. ej. un ZIP descomprimido acá, que
# trae PII directa: nombre, email, país, teléfono, y el historial completo).
*.json
!package.json
!test/fixtures/*.json

# Comprimidos: pueden contener la export completa dentro del árbol de trabajo.
*.zip
*.gz
*.json.gz

# Tests temporales (convención "_" = se borran al deploy)
test/_*.test.js

# Cuaderno local del agente: no se publica en el repo.
AGENTS.md
